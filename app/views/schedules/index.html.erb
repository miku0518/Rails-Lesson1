<h1>予定一覧</h1>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<p>
  <%= link_to "新規追加", new_schedule_path, class: "btn btn-primary" %>
</p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
    </tr>
  </thead>
  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.to_fs(:jp_date) %></td>
        <td><%= schedule.end_date.to_fs(:jp_date) %></td>
        <td><%= schedule.allday ? "○" : "" %></td>
        <td><%= schedule.updated_at.to_fs(:jp_datetime) %></td>
        <td>
          <%= link_to "詳細", schedule_path(schedule) %> 
          <%= link_to "編集", edit_schedule_path(schedule) %> 
          <%= link_to "削除", schedule, data: { turbo_method: :delete, turbo_confirm: "予定を削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>
  予定合計 <%= @schedules.count %> 件 本日の日付 <%= Date.today.strftime("%Y/%m/%d") %>
</p>
