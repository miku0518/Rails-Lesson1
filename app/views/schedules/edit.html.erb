<h1>予定を編集</h1>

<% if flash[:alert] %>
  <p class="notice"><%= flash[:alert] %></p>
<% end %>

<%= form_with model: @schedule, local: true do |form| %>
  <div>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :start_date, "開始日" %><br>
    <%= form.date_field :start_date %>
  </div>

  <div>
    <%= form.label :end_date, "終了日" %><br>
    <%= form.date_field :end_date %>
  </div>

  <div>
    <%= form.check_box :allday %>
    <%= form.label :allday, "終日の場合はチェックを入れます" %>
  </div>

  <div>
    <%= form.label :memo, "スケジュールメモ" %><br>
    <%= form.text_area :memo %>
  </div>

  <div>
    <%= form.submit "保存" %>
  </div>
<% end %>

<%= link_to "キャンセル", schedules_path %>
